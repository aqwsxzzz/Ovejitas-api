            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_AssetRead_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "List assets in a farm",
        "tags": [
          "assets"
        ]
